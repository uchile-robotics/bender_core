<?xml version="1.0"?>
<robot name="bender" xmlns:xacro="http://www.ros.org/wiki/xacro">


  <xacro:macro name="sim_position_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="sim_shoulder_joint" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="sim_mimic_joint" params="name">
    <joint name="${name}">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="sim_wheel_joint" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </xacro:macro>

  <ros2_control name="RobotSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- left arms -->
    <xacro:sim_shoulder_joint name="l1l_to_base_link"/>
    <xacro:sim_position_joint name="l2l_to_l1l"/>
    <xacro:sim_position_joint name="l3l_to_l2l"/>
    <xacro:sim_position_joint name="l4l_to_l3l"/>
    <xacro:sim_position_joint name="l5l_to_l4l"/>
    <xacro:sim_position_joint name="l6l_to_l5l"/>

    <!-- right arms -->
    <xacro:sim_shoulder_joint name="l1r_to_base_link"/>
    <xacro:sim_position_joint name="l2r_to_l1r"/>
    <xacro:sim_position_joint name="l3r_to_l2r"/>
    <xacro:sim_position_joint name="l4r_to_l3r"/>
    <xacro:sim_position_joint name="l5r_to_l4r"/>
    <xacro:sim_position_joint name="l6r_to_l5r"/>

    <!-- Head -->
    <xacro:sim_position_joint name="l1h_to_base_link"/>
    <xacro:sim_position_joint name="l2h_to_l1h"/>
    <xacro:sim_position_joint name="l3h_to_l1h"/>

    <!-- Grippers -->
    <xacro:sim_position_joint name="gripper_base_to_movil"/>
    <xacro:sim_position_joint name="g2ra_to_g1r"/>
    <xacro:sim_mimic_joint name="g2rb_to_g1r"/>

    <xacro:sim_wheel_joint name="wrl_to_base_link"/>
    <xacro:sim_wheel_joint name="wrr_to_base_link"/>
    <xacro:sim_mimic_joint name="wfl_to_base_link"/>
    <xacro:sim_mimic_joint name="wfr_to_base_link"/>
  </ros2_control>

  <gazebo reference="laser_1">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0.037 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>laser_1</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>500</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find bender_description)/config/controllers/controllers.yaml</parameters>
      <ros>
        <namespace>/bender</namespace>
        <remapping>robot_description:=/robot_description</remapping>
      </ros>
    </plugin>
  </gazebo>

</robot>
