         <ros2_control name="DynamixelChainMain" type="system">
             <hardware>
               <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>
               <param name="port_name">/dev/dynamixel</param>
               <param name="baud_rate">1000000</param>
               <param name="protocol_version">1.0</param>
               <param name="number_of_joints">14</param>
               <param name="number_of_transmissions">14</param>
               <param name="dynamixel_model_folder">/param/dxl_model</param>
               <param name="disable_torque_at_init">true</param>
               <param name="torque_enable">0</param>
             </hardware>

             <joint name="l2r_to_l1r">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
             </joint>
             <joint name="l3r_to_l2r">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
             </joint>
             <joint name="l4r_to_l3r">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
             </joint>
             <joint name="l5r_to_l4r">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
             </joint>
             <joint name="l6r_to_l5r">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
             </joint>

             <joint name="l2l_to_l1l">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
             </joint>
             <joint name="l3l_to_l2l">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
             </joint>
             <joint name="l5l_to_l4l">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
             </joint>
             <joint name="l6l_to_l5l">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
             </joint>

             <joint name="g2ra_to_g1r">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
             </joint>
             <joint name="g2rb_to_g1r">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
             </joint>
             <!-- <joint name="g2r_to_g1r"><command_interface name="position" /><state_interface name="position" /><state_interface name="velocity" /></joint> -->
             <joint name="l1h_to_base_link">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
             </joint>
             <joint name="l2h_to_l1h">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
             </joint>
             <!-- <joint name="l2h_to_l1h_coupled"><command_interface name="position" /><state_interface name="position" /><state_interface name="velocity" /></joint> -->


             <gpio name="motor_l2r">
                <param name="type">dxl</param>
                <param name="ID">11</param>
                <command_interface name="Goal Position" />
                <state_interface name="Present Position" />
                <state_interface name="Present Velocity" />
                <state_interface name="Present Load" />
                <!-- software re-center -->
                <param name="[unit info]">Present Position, 0.001533981, rad, unsigned, -3.1001879291; Goal Position, 0.001533981, rad, unsigned, -3.1001879291</param>
                <param name="P Gain">8</param>
                <param name="I Gain">2</param>
                <param name="D Gain">5</param>
                <param name="Return Delay Time">25</param>
            </gpio>

             <gpio name="motor_l3r">
                <param name="type">dxl</param>
                <param name="ID">12</param>
                <command_interface name="Goal Position" />
                <state_interface name="Present Position" />
                <state_interface name="Present Velocity" />
                <state_interface name="Present Load" />
                <!-- doesn't need recentering -->
                <param name="CW Compliance Margin">1</param>
                <param name="CCW Compliance Margin">1</param>
                <param name="CW Compliance Slope">254</param>
                <param name="CCW Compliance Slope">254</param>
                <param name="Return Delay Time">25</param>
             </gpio>
             <gpio name="motor_l4r">
                <param name="type">dxl</param>
                <param name="ID">13</param>
                <command_interface name="Goal Position" />
                <state_interface name="Present Position" />
                <state_interface name="Present Velocity" />
                <state_interface name="Present Load" />
                <param name="[unit info]">Present Position, 0.001533981, rad, unsigned, -3.471399003; Goal Position, 0.001533981, rad, unsigned, -3.471399003</param>
                <param name="P Gain">8</param>
                <param name="I Gain">2</param>
                <param name="D Gain">5</param>
                <param name="Return Delay Time">25</param>
             </gpio>
             <gpio name="motor_l5r">
                <param name="type">dxl</param>
                <param name="ID">14</param>
                <command_interface name="Goal Position" />
                <state_interface name="Present Position" />
                <state_interface name="Present Velocity" />
                <state_interface name="Present Load" />
                <param name="CW Compliance Margin">1</param>
                <param name="CCW Compliance Margin">1</param>
                <param name="CW Compliance Slope">254</param>
                <param name="CCW Compliance Slope">254</param>
                <param name="Return Delay Time">25</param>
             </gpio>
             <gpio name="motor_l6r">
                <param name="type">dxl</param>
                <param name="ID">15</param>
                <command_interface name="Goal Position" />
                <state_interface name="Present Position" />
                <state_interface name="Present Velocity" />
                <state_interface name="Present Load" />
                <param name="CW Compliance Margin">1</param>
                <param name="CCW Compliance Margin">1</param>
                <param name="CW Compliance Slope">254</param>
                <param name="CCW Compliance Slope">254</param>
                <param name="Return Delay Time">25</param>
             </gpio>

             <gpio name="motor_l2l">
                <param name="type">dxl</param>
                <param name="ID">4</param>
                <command_interface name="Goal Position" />
                <state_interface name="Present Position" />
                <state_interface name="Present Velocity" />
                <state_interface name="Present Load" />
                <param name="[unit info]">Present Position, 0.001047198, rad, unsigned, -1.6221098; Goal Position, 0.001047198, rad, unsigned, -1.6221098</param>
                <param name="CW Compliance Margin">1</param>
                <param name="CCW Compliance Margin">1</param>
                <param name="CW Compliance Slope">254</param>
                <param name="CCW Compliance Slope">254</param>
                <param name="Return Delay Time">25</param>
             </gpio>
             <gpio name="motor_l3l">
                <param name="type">dxl</param>
                <param name="ID">3</param>
                <command_interface name="Goal Position" />
                <state_interface name="Present Position" />
                <state_interface name="Present Velocity" />
                <state_interface name="Present Load" />
                <param name="[unit info]">Present Position, 0.005061455, rad, unsigned, -2.070135026; Goal Position, 0.005061455, rad, unsigned, -2.070135026</param>
                <param name="CW Compliance Margin">1</param>
                <param name="CCW Compliance Margin">1</param>
                <param name="CW Compliance Slope">254</param>
                <param name="CCW Compliance Slope">254</param>
                <param name="Return Delay Time">25</param>
             </gpio>
             <gpio name="motor_l5l">
                <param name="type">dxl</param>
                <param name="ID">5</param>
                <command_interface name="Goal Position" />
                <state_interface name="Present Position" />
                <state_interface name="Present Velocity" />
                <state_interface name="Present Load" />
                <param name="CW Compliance Margin">1</param>
                <param name="CCW Compliance Margin">1</param>
                <param name="CW Compliance Slope">254</param>
                <param name="CCW Compliance Slope">254</param>
                <param name="Return Delay Time">25</param>
             </gpio>
             <gpio name="motor_l6l">
                <param name="type">dxl</param>
                <param name="ID">6</param>
                <command_interface name="Goal Position" />
                <state_interface name="Present Position" />
                <state_interface name="Present Velocity" />
                <state_interface name="Present Load" />
                <param name="CW Compliance Margin">1</param>
                <param name="CCW Compliance Margin">1</param>
                <param name="CW Compliance Slope">254</param>
                <param name="CCW Compliance Slope">254</param>
                <param name="Return Delay Time">25</param>
             </gpio>

             <gpio name="motor_g2ra">
                <param name="type">dxl</param>
                <param name="ID">16</param>
                <command_interface name="Goal Position" />
                <state_interface name="Present Position" />
                <state_interface name="Present Velocity" />
                <state_interface name="Present Load" />
                <param name="CW Compliance Margin">1</param>
                <param name="CCW Compliance Margin">1</param>
                <param name="CW Compliance Slope">254</param>
                <param name="CCW Compliance Slope">254</param>
                <param name="Return Delay Time">25</param>
             </gpio>
             <gpio name="motor_g2rb">
                <param name="type">dxl</param>
                <param name="ID">17</param>
                <command_interface name="Goal Position" />
                <state_interface name="Present Position" />
                <state_interface name="Present Velocity" />
                <state_interface name="Present Load" />
                <param name="CW Compliance Margin">1</param>
                <param name="CCW Compliance Margin">1</param>
                <param name="CW Compliance Slope">254</param>
                <param name="CCW Compliance Slope">254</param>
                <param name="Return Delay Time">25</param>
             </gpio>
             <gpio name="motor_g2r">
                <param name="type">dxl</param>
                <param name="ID">7</param>
                <command_interface name="Goal Position" />
                <state_interface name="Present Position" />
                <state_interface name="Present Velocity" />
                <state_interface name="Present Load" />
                <param name="CW Compliance Margin">1</param>
                <param name="CCW Compliance Margin">1</param>
                <param name="CW Compliance Slope">254</param>
                <param name="CCW Compliance Slope">254</param>
                <param name="Return Delay Time">25</param>
             </gpio>

             <gpio name="motor_l1h">
                <param name="type">dxl</param>
                <param name="ID">19</param>
                <command_interface name="Goal Position" />
                <state_interface name="Present Position" />
                <state_interface name="Present Velocity" />
                <state_interface name="Present Load" />
                <param name="CW Compliance Margin">1</param>
                <param name="CCW Compliance Margin">1</param>
                <param name="CW Compliance Slope">254</param>
                <param name="CCW Compliance Slope">254</param>
                <param name="Return Delay Time">25</param>
             </gpio>

             <joint name="l4l_to_l3l">
               <command_interface name="position" />
               <state_interface name="position" />
               <state_interface name="velocity" />
             </joint>

             <gpio name="motor_l4l">
               <param name="type">dxl</param>
               <param name="ID">1</param>
               <command_interface name="Goal Position" />
               <state_interface name="Present Position" />
               <state_interface name="Present Velocity" />
               <state_interface name="Present Load" />
               <param name="[unit info]">Present Position, 0.001533981, rad, unsigned, -2.963651292; Goal Position, 0.001533981, rad, unsigned, -2.963651292</param>
               <param name="P Gain">8</param>
               <param name="I Gain">2</param>
               <param name="D Gain">5</param>
               <param name="Return Delay Time">25</param>
             </gpio>
