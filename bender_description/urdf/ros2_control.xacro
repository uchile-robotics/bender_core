  <xacro:odrive_ros2_control
    name="OdriveLeft"
    serial_number="336B33573235"
    joint_name="l1l_to_base_link"
    axis="0"/>

  <xacro:odrive_ros2_control
    name="OdriveRight"
    serial_number="CAMBIA EL NUMERO DE SERIE LUCHO"
    joint_name="l1r_to_base_link"
    axis="0"/>

  <transmission name="trans_l1l_to_base_link">
    <plugin>transmission_interface/SimpleTransmission</plugin>
