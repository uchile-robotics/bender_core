			<param name="P Gain">8</param>
			<param name="I Gain">2</param>
			<param name="D Gain">5</param>
			<param name="Return Delay Time">10</param>
		</gpio>
		<joint name="l5r_to_l4r">
			<command_interface name="position" />
			<state_interface name="position" />
