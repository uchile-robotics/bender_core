			<state_interface name="Present Load" />
			<param name="[unit info]">Present Position, 0.005061455, rad, unsigned, -1.94866011; Goal Position, 0.005061455, rad, unsigned, -1.94866011</param>
			<param name="CW Compliance Margin">1</param>
			<param name="CCW Compliance Margin">1</param>
			<param name="CW Compliance Slope">32</param>
			<param name="CCW Compliance Slope">32</param>
			<param name="Return Delay Time">10</param>
		</gpio>
		<joint name="l2l_to_l1l">
			<command_interface name="position" />
			<state_interface name="position" />
			<state_interface name="velocity" />
