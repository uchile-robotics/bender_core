        </link>

        <joint name="gripper_base_to_fijo" type="fixed">
          <parent link="gripper_l_base"/>
          <child link="fijo"/>
          <origin xyz="0 0 0"/>
        </joint>

        <link name="fijo">
          <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
