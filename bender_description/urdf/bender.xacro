  <joint name="l6l_to_gripper" type="fixed">
      <origin xyz="0.0 -0.02225 -0.091" rpy="0 3.14159 0"/>
      <parent link="l6l_1"/>
      <child link="gripper_l_base"/>
    </joint>

    <link name="gripper_l_base">
          <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
              <mesh filename="file://$(find bender_description)/meshes/base.stl" scale="0.001 0.001 0.001"/>
