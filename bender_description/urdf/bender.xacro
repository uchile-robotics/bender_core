            </geometry>
          </collision>
        </link>

        <joint name="gripper_base_to_movil" type="revolute">
          <axis xyz="0 1 0"/>
          <origin rpy="0 -1.0 0" xyz="-0.01869 0 -0.01945"/>
          <parent link="gripper_l_base"/>
          <child link="movil"/>
          <limit effort="1000.0" lower="0.0" upper="0.5" velocity="0.5"/>
        </joint>

        <link name="movil">
