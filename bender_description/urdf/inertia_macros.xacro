<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Macros -->
  <!-- Cilindro -->
  <xacro:macro name="cylinder_inertia_def" params="length radius mass">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="${mass}"/>
    <inertia ixx="${mass * (3 * radius * radius + length * length) / 12}"
             ixy="0"
             ixz="0"
             iyy="${mass * radius * radius / 2}"
             iyz="0"
             izz="${mass * (3 * radius * radius + length * length) / 12}"/>
  </inertial>
  </xacro:macro>

  <!-- Cuboide -->
  <xacro:macro name="cuboid_inertia_def" params="x y z mass">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="${mass}"/>
    <inertia ixx="${mass * (y * y + z * z) / 12}"
             ixy="0"
             ixz="0"
             iyy="${mass * (x * x + y * y) / 12}"
             iyz="0"
             izz="${mass * (x * x + z * z) / 12}"/>
  </inertial>
  </xacro:macro>
</robot>