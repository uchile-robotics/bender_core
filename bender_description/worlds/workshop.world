<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="workshop_world">

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Luz solar y ambiental -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.8 0.8 0.8 1</background>
    </scene>

    <!-- Piso -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <pose>0 0 0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Paredes -->
    <model name="workshop_walls">
      <static>true</static>
      <link name="front_wall">
        <pose>0 -5 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>10 0.2 3</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>10 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="back_wall">
        <pose>0 5 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>10 0.2 3</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>10 0.2 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="left_wall">
        <pose>-5 0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.2 10 3</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 10 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="right_wall">
        <pose>5 0 1.5 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.2 10 3</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 10 3</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Mesas -->
    <model name="table1">
      <static>true</static>
      <pose>-3 2 0 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.75 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>2 1 0.1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>2 1 0.1</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table2">
      <static>true</static>
      <pose>3 2 0 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.75 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>2 1 0.1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>2 1 0.1</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table3">
      <static>true</static>
      <pose>-3 -2 0 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.75 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>2 1 0.1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>2 1 0.1</size></box></geometry>
          <material><ambient>0.5 0.5 0.7 1</ambient><diffuse>0.5 0.5 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table4">
      <static>true</static>
      <pose>3 -2 0 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.75 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>2 1 0.1</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>2 1 0.1</size></box></geometry>
          <material><ambient>0.7 0.5 0.5 1</ambient><diffuse>0.7 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Objetos compuestos y tomables -->

    <!-- Mesa 1: Martillo -->
    <model name="hammer">
      <pose>-3.8 1.60 0.85 0 0 0</pose>
      <link name="mango">
        <pose>0 0 0 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.2 0.02 0.02</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 0.02 0.02</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material></visual>
      </link>
      <link name="head">
        <pose>0.1 0 0.03 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.05 0.05 0.08</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.05 0.05 0.08</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Mesa 1: Oso de peluche -->
    <model name="teddy_bear">
      <pose>-2.6 1.66 0.85 0 0 0</pose>
      <link name="body">
        <collision name="col"><geometry><sphere><radius>0.08</radius></sphere></geometry></collision>
