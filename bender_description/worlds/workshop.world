        <visual name="vis"><geometry><cylinder><radius>0.015</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.9 0.6 0.3 1</ambient><diffuse>0.9 0.6 0.3 1</diffuse></material></visual>
