      </link>
      <link name="left_arm">
        <pose>-0.09 0 0.05 0 0 0</pose>
        <collision name="col"><geometry><cylinder><radius>0.015</radius><length>0.08</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.015</radius><length>0.08</length></cylinder></geometry>
