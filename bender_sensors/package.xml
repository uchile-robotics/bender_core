<?xml version="1.0"?>
<package format="3">
  <name>bender_sensors</name>
  <version>2.0.0</version>
  <description>Sensores de Bender - UChile Homebreakers</description>

  <maintainer email="bender.devel@gmail.com">Bender Team - UChile Homebreakers</maintainer>
  <author email="bender.devel@gmail.com">Bender Team - UChile Homebreakers</author>

  <license>MIT</license> <!-- Cambia esto si usas otra licencia -->

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencias comunes en ROS 2 -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>usb_cam</depend>

  <!-- Si uchile_msgs y uchile_srvs están porteados a ROS 2 -->
  <depend>uchile_msgs</depend>
  <depend>uchile_srvs</depend>
  <depend>uchile_util</depend>

  <!-- Dependencias opcionales (si existen en ROS 2) -->
  <exec_depend>urg_node</exec_depend>
  <exec_depend>image_view</exec_depend>
  <exec_depend>openni_launch</exec_depend>
  <exec_depend>openni2_launch</exec_depend>

  <!-- Exportar el tipo de build -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
