<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bender">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import bender urdf file -->
    <xacro:include filename="$(find bender_description)/urdf/bender.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="bender.ros2_control.xacro" />


    <xacro:bender_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
